{
    "hosting": [
        {
            "target": "biz",
            "public": "dist/biz",
            "cleanUrls": true,
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "rewrites": [
                {
                    "source": "/linktree",
                    "destination": "/linktree.html"
                },
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "headers": [
                {
                    "source": "/_next/**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=31536000, immutable"
                        }
                    ]
                },
                {
                    "source": "/scripts/**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=86400"
                        }
                    ]
                },
                {
                    "source": "**/*.@(html|txt)",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache"
                        }
                    ]
                }
            ]
        },
